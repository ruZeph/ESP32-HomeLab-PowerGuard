# Applied when sdkconfig is generated from scratch. An existing sdkconfig is
# not modified by this file.

# LAN OTA: two application slots plus otadata, defined in partitions.csv.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Boot a freshly updated image in PENDING_VERIFY state and fall back to the
# previous image unless the new one confirms itself via
# esp_ota_mark_app_valid_cancel_rollback().
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Build for size: the application lives in a 1856K OTA slot, so a smaller image
# keeps headroom for future features and shortens LAN update transfers.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# The controller is station-only and never brings up a SoftAP interface.
# CONFIG_ESP_WIFI_SOFTAP_SUPPORT is not set

# SNTP starts before the first DHCP lease exists, so the initial request can
# fail. Retry every minute instead of every hour so the clock appears shortly
# after boot rather than an hour later. The traffic is negligible.
CONFIG_LWIP_SNTP_UPDATE_DELAY=60000
